# Copy to .env.local for local overrides (*.local files are git-ignored).
# Only VITE_-prefixed values reach the browser bundle: never put secrets here.

# Base URL of the FastAPI backend, WITHOUT a trailing /api.
# Use "localhost" (not 127.0.0.1) to match the frontend origin, otherwise the
# browser will not send the SameSite=Strict session cookie.
VITE_API_BASE_URL=http://localhost:8000
