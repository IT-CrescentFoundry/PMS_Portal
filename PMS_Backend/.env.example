# Template for PMS_Backend/.env — copy this file to .env and fill in real values.
# Never commit .env; it is excluded by the repository .gitignore.

# MySQL connection (DB_NAME, DB_USER and DB_PASSWORD are required)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pms
DB_USER=pms_app
DB_PASSWORD=change-me

# Authentication (required). Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to true whenever the API is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Browser origins allowed to call the API with credentials (comma-separated,
# explicit origins only). Also trusted by the CSRF Origin check.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login throttling (failed attempts within the window, per client IP and per
# username). In-memory: per process only (see docs/api.md).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Automated tests run ONLY against this database (must end with _test).
TEST_DB_NAME=pms_test
# Browser end-to-end tests run ONLY against this database (must end with _e2e_test).
E2E_DB_NAME=pms_e2e_test
# Optional: dedicated test credentials (default: DB_USER / DB_PASSWORD).
# TEST_DB_USER=
# TEST_DB_PASSWORD=

# Local demo only: `python -m app.seed` gives every demo account this
# password (min. 12 characters). Leave empty to create accounts without one.
DEMO_USER_PASSWORD=
